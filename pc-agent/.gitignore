# Secrets
Backend/.env
.env

# Runtime artifacts
**/__pycache__/
*.pyc
**/*.log
Backend/logs/

# Virtual environments
.venv/
venv/

# LibreHardwareMonitor runtime config (mutated on every run)
Backend/lib/LibreHardwareMonitor.config

# PyInstaller build artifacts. The dist/agent/ folder needs to exist (Tauri's
