# Copy this file to `.env` in the same folder and fill in your own values.
# `.env` is gitignored and must never be committed.
#
#   cp Backend/.env.example Backend/.env
#
# Every variable here is optional — the agent falls back to the defaults
# baked into agent.py, so a plain `python Backend/agent.py` works out of
# the box against the default Supabase project.

# --- Supabase -------------------------------------------------------------
# Your project URL and its anon (public) key. The anon key is safe to ship
# in clients: Row Level Security is what scopes every read and write to the
# signed-in user. NEVER put the service_role key here — it bypasses RLS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Agent identity -------------------------------------------------------
# Name this machine shows under in the mobile and desktop apps.
DEVICE_NAME=My PC

# Seconds between sensor reads pushed to the cloud. Clamped to 1-60.
POLLING_INTERVAL=2

# --- Local API ------------------------------------------------------------
# Port the local server binds on (127.0.0.1 only). The desktop app expects
# 8420; change both sides together if you move it.
LOCAL_PORT=8420

# --- Not for manual use ---------------------------------------------------
# TAURI_ACCESS_TOKEN / TAURI_REFRESH_TOKEN are injected by the Tauri desktop
# app when it spawns the agent as a sidecar. Leave them unset — setting them
# by hand bypasses the keyring-backed pairing flow.
